{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-json": "*",
        "aws/aws-sdk-php-laravel": "^3.11",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^5.0",
        "guzzlehttp/guzzle": "^7.10",
        "intervention/image-laravel": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.1",
        "luecano/numero-a-letras": "^2.2",
        "maatwebsite/excel": "^3.1",
        "php-flasher/flasher-laravel": "^2.6",
        "rawilk/laravel-settings": "^4.0",
        "spatie/laravel-permission": "^8.0",
        "twilio/sdk": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "filament/blueprint": "^2.2",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [{
        "name": "filament",
        "type": "composer",
        "url": "https://packages.filamentphp.com/composer"
    }]
}
